    "@lore/mcp": "workspace:*",
    "@lore/proxy": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "4.0.2",
    "otplib": "13.5.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "5.x",
    "vitest": "3.x"
