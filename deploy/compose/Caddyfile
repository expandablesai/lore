# Lore edge proxy.
#
# Authelia only accepts HTTPS targets (it refuses insecure schemes so session
# cookies are always transmitted securely), so TLS terminates here with Caddy's
# internal CA. When the Cloudflare Tunnel is wired up it should point at
# https://caddy:443 with certificate verification disabled for the origin.
#
# Two hostnames:
#   lore.dushyant.com  - the app (behind Authelia)
#   auth.dushyant.com  - the Authelia portal (must stay reachable without auth)

(lore_app) {
	# API calls are made by the console with fetch(). Telling the browser to
	# follow a redirect to the portal host turns a lapsed session into an opaque
	# "NetworkError" (the redirect is cross-origin and carries no CORS headers),
	# so the gate answers a plain 401 here and the console decides to re-enter
	# the portal. `route` keeps the order literal: the session check must see
	# the original /api path, before the prefix is stripped for the app.
	handle /api/* {
		route {
			forward_auth authelia:9091 {
				uri /api/verify
				header_up X-Forwarded-Proto https
				# Authelia redirects browsers to the portal but answers 401 to
				# client code that asks for JSON; /api is only ever called by fetch,
				# so always ask as JSON.
				header_up Accept application/json
				copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
			}
			uri strip_prefix /api
			reverse_proxy app:3001
		}
	}

	handle {
		forward_auth authelia:9091 {
			uri /api/verify?rd=https://auth.dushyant.com
			header_up X-Forwarded-Proto https
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

https://lore.dushyant.com {
	tls internal
	import lore_app
}

https://auth.dushyant.com {
	tls internal
	reverse_proxy authelia:9091
}

http://lore.dushyant.com, http://auth.dushyant.com {
	redir https://{host}{uri} 308
}
