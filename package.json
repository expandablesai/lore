{
  "name": "lore",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "bundle": "node tooling/bundle.mjs",
    "lock:check": "node scripts/lock.mjs check",
    "lock:update": "node scripts/lock.mjs update",
    "test": "node scripts/lock.mjs check && pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @lore/db generate",
    "db:migrate": "pnpm --filter @lore/db migrate",
    "db:apply-rls": "pnpm --filter @lore/db apply-rls",
    "db:push": "pnpm --filter @lore/db push"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
